{
  "$comment": "Shared contract for the slot algorithm. Both backend (pytest) and frontend (vitest) run every case.",
  "cases": [
    {
      "name": "empty day, 30-minute grid",
      "work": ["10:00", "12:00"],
      "duration": 60, "step": 30, "buffer": 0,
      "busy": [], "breaks": [], "notBefore": null,
      "expected": ["10:00", "10:30", "11:00"]
    },
    {
      "name": "existing booking splits the day",
      "work": ["10:00", "14:00"],
      "duration": 60, "step": 30, "buffer": 0,
      "busy": [["11:00", "12:00"]], "breaks": [], "notBefore": null,
      "expected": ["10:00", "12:00", "12:30", "13:00"]
    },
    {
      "name": "lunch break is respected",
      "work": ["12:00", "16:00"],
      "duration": 60, "step": 30, "buffer": 0,
      "busy": [], "breaks": [["13:00", "14:00"]], "notBefore": null,
      "expected": ["12:00", "14:00", "14:30", "15:00"]
    },
    {
      "name": "cleanup buffer around bookings",
      "work": ["10:00", "14:00"],
      "duration": 30, "step": 15, "buffer": 15,
      "busy": [["11:00", "12:00"]], "breaks": [], "notBefore": null,
      "expected": ["10:00", "10:15", "12:15", "12:30", "12:45", "13:00", "13:15", "13:30"]
    },
    {
      "name": "no slots in the past",
      "work": ["10:00", "13:00"],
      "duration": 30, "step": 30, "buffer": 0,
      "busy": [], "breaks": [], "notBefore": "11:20",
      "expected": ["11:30", "12:00", "12:30"]
    },
    {
      "name": "service longer than the working day",
      "work": ["10:00", "11:00"],
      "duration": 90, "step": 15, "buffer": 0,
      "busy": [], "breaks": [], "notBefore": null,
      "expected": []
    },
    {
      "name": "fully booked day",
      "work": ["10:00", "12:00"],
      "duration": 30, "step": 15, "buffer": 0,
      "busy": [["10:00", "11:00"], ["11:00", "12:00"]], "breaks": [], "notBefore": null,
      "expected": []
    },
    {
      "name": "booking ending off-grid keeps the grid",
      "work": ["10:00", "12:00"],
      "duration": 30, "step": 15, "buffer": 0,
      "busy": [["10:00", "10:50"]], "breaks": [], "notBefore": null,
      "expected": ["11:00", "11:15", "11:30"]
    },
    {
      "name": "slot may end exactly when the day ends",
      "work": ["18:00", "19:00"],
      "duration": 60, "step": 15, "buffer": 0,
      "busy": [], "breaks": [], "notBefore": null,
      "expected": ["18:00"]
    }
  ]
}
