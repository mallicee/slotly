# Copy to .env and fill in. Never commit real secrets.

# Long random string used to sign admin tokens (python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=

# SQLite by default; PostgreSQL works too: postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///./slotly.db

# Business time zone for "today" and lead-time rules
BUSINESS_TZ=Europe/Moscow

# Frontend origins allowed to call the API (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173

# Admin account created on first start (with SEED_DEMO=1)
ADMIN_EMAIL=admin@slotly.demo
ADMIN_PASSWORD=demo1234
SEED_DEMO=1

# Optional: Telegram notifications about new bookings
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
